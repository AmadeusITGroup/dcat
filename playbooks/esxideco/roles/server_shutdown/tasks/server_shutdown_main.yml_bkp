        # #     password: "{{ remote_password }}"
        # #     command: |
        # #       partedUtil delete {{ item }}
        # #   loop: "{{ local_disks_list }}"  # Corrected to use the proper variable
        # #   when: local_disks_list is defined and local_disks_list | length > 0  # Ensure there are disks to process
        # #   delegate_to: localhost
        # #   register: wipe_results
        # #   ignore_errors: yes

        # # - name: "Debug Wipe Results"
        # #   debug:
        # #     msg:
        # #       - "Command: {{ item.item }}"
        # #       - "STDOUT: {{ item.stdout }}"
        # #       - "STDERR: {{ item.stderr }}"
        # #       - "Status: {{ item.status }}"
        # #   loop: "{{ wipe_results.results }}"
        # #   loop_control:
        # #     label: "{{ item.item }}"
        # #   when: wipe_results is defined



          
        - name: "Shutdown ESXi (Immediate)"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli system shutdown poweroff -d 10 -r 'Immediate shutdown'"
          register: shutdown_result
          delegate_to: localhost


        - name: "Debug: Show immediate shutdown result"
          debug:
            var: shutdown_result

        - name: "Fail if immediate shutdown failed"
          fail:
            msg: "Critical Error: Failed to shutdown ESXi host {{ esxi_fqdn }}."
          # when: "'error' in shutdown_result.stdout.lower()"
          # when: shutdown_result.failed or ('error' in shutdown_result.stdout | lower)
          when: shutdown_result.status == 'failure'

        - name: Wait for a short period after initiating shutdown"
          pause:
            seconds: 15
          when: shutdown_result.status == 'success'

        # - name: "Check if ESXi host is down after shutdown"
        #   wait_for_connection:
        #     host: "{{ esxi_fqdn }}"
        #     port: 22
        #     state: absent  # Expect the connection to be absent (down)
        #     timeout: 60    # Wait for up to 60 seconds
        #   register: check_down_result
        #   ignore_errors: yes # Allow this task to fail

        - name: "Check if ESXi host is down after shutdown"
          wait_for:
            host: "{{ esxi_fqdn }}"
            port: 22
            state: stopped  # Wait for the port to stop accepting connections
            timeout: 60     # Wait for up to 60 seconds
          register: check_down_result
          ignore_errors: yes # Allow this task to fail
          delegate_to: localhost



        - name: "Debug: Show check down result"
          debug:
            var: check_down_result


        - name: Get timestamp from the system
          shell: "date +%Y-%m-%d/%H:%M"
          delegate_to: localhost
          register: tstamp              
                      

        - set_fact:
            time: "{{tstamp.stdout}}"
            
        - name: "Server Shutdown Success for host"
          shell: echo "{{ inventory_hostname }}, {{ time }}, [INFO] - Server Shutdown Completed for host - Powered Off" >> {{ shutdown_success }}                    
          delegate_to: localhost
          # when: shutdown_result.status is defined
          # when: not shutdown_result.failed and ('error' not in shutdown_result.stdout | lower) and check_down_result.unreachable
          # when: shutdown_result.status == 'success' and check_down_result.unreachable
          when: shutdown_result.status == 'success' and check_down_result.failed



        - name: "Server Shutdown Failed for host"
          shell: echo "{{ inventory_hostname }}, {{ time }}, [ERROR] - Server Shutdown Failed for host" >> {{ shutdown_failure }}                    
          delegate_to: localhost
          # when: shutdown_result.status is not defined
          # when: shutdown_result.failed or ('error' in shutdown_result.stdout | lower) or not check_down_result.unreachable
          when: shutdown_result.status == 'failure' or not check_down_result.failed


        - name: "update entry for DECO server for Server Shutdown"
          azure_update_module_vals_esxi:
            connection_string: "{{ private_endpoint_connection_string }}"
            hostname: "{{inventory_hostname}}"
            module_name: "server_shutdown"
            status: "T"           
          register: update_status_info_state
          delegate_to: localhost
          # when: shutdown_result.status is defined
          # when: not shutdown_result.failed and ('error' not in shutdown_result.stdout | lower) and check_down_result.unreachable
          when: shutdown_result.status == 'success' and check_down_result.failed

        - meta: end_host
          # when: shutdown_result.failed or ('error' in shutdown_result.stdout | lower) or not check_down_result.unreachable
          when: shutdown_result.failed or ('error' in shutdown_result.stdout | lower) or not check_down_result.failed



      rescue: 
        - name: when above one throws error the below task should execute
          debug:
            msg: "Exception occurred but rescued - check errors for Shutdown module"  

        - name: Get timestamp from the system
          shell: "date +%Y-%m-%d/%H:%M"
          delegate_to: localhost
          register: tstamp              
                  
        - set_fact:
            time: "{{tstamp.stdout}}"

        - name: "Failure information to file in rescue block"
          shell: echo "{{ inventory_hostname }}, {{ time }}, [ERROR], Kindly check server shutdown module for esxi servers" >> {{ shutdown_failure }}                    
          delegate_to: localhost