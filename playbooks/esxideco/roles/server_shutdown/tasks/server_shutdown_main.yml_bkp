        - name: "Wipe /boot and system partitions"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: |
              rm -rf bootbank/*
              rm -rf /vmfs/volumes/BOOTBANK*

      # Another directory
          register: wipe_partitions
          delegate_to: localhost

        - name: Log Success for Wiping /boot and System Partitions
          shell: echo "{{ inventory_hostname }}, {{ time }}, [INFO] - /boot and system partitions wiped successfully" >> {{ shutdown_success }}
          delegate_to: localhost
          # when: "'Successfully' in wipe_partitions.msg"
          # when: wipe_partitions.rc == 0
          when: wipe_partitions.status == 'success'


        - name: Log Failure for Wiping bootbank and System Partitions
          shell: echo "{{ inventory_hostname }}, {{ time }}, [ERROR] - Failed to wipe /boot and system partitions for {{ inventory_hostname }}" >> {{ shutdown_failure }}
          delegate_to: localhost
          # when: "'Successfully' not in wipe_partitions.msg"
          # when: wipe_partitions.rc != 0
          when: wipe_partitions.status == 'failure'

        - meta: end_host
          # when: "'Successfully' not in wipe_partitions.msg"
          when: wipe_partitions.status == 'failure'

