          register: local_disks_uuid
          delegate_to: localhost



        - name: "Set local disks uuid list"
          set_fact:
            local_disks_uuid_list: "{{ local_disks_uuid.output.split('\n') | reject('equalto', '') | list }}"  # Reject empty strings
          when: local_disks_uuid is defined and local_disks_uuid.output is defined and local_disks_uuid.output | length > 0

        # - name: Log Success for Local Storage Devices Fetch
        #   shell: echo "{{ inventory_hostname }}, {{ time }}, [INFO] - Local storage devices fetched successfully {{ local_disks_uuid.output }}" >> {{ shutdown_success }} 
