        - name: "Identify local storage devices on ESXi"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli storage core device list | awk -F ': ' '/Devfs Path:/ { dev_path = $2 } /Other UIDs:/ { if ($0 ~ /{{ item }}/) { print dev_path; exit } }'"
          loop: "{{ local_disks_uuid_list }}"
          register: local_disks_path
          delegate_to: localhost
          when: local_disks_uuid_list is defined and local_disks_uuid_list | length > 0


        - name: "Set local disks list"
          set_fact:
            local_disks_path_list: "{{ local_disks_path.output.split('\n') | reject('equalto', '') | list }}"  # Reject empty strings
          when: local_disks_path is defined and local_disks_path.output is defined and local_disks_path.output | length > 0

        # - name: "Set local disks list"
        #   set_fact:
        #     local_disks_path_list: "{{ local_disks_path.results | map(attribute='stdout') | reject('equalto', '') | list }}"  # Reject empty strings
        #   when: local_disks_path is defined and local_disks_path.results | length > 0

        - name: "Get partition table for each local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "partedUtil getptbl {{ item }}"
          loop: "{{ local_disks_path_list }}"
          delegate_to: localhost
          register: partition_info
          ignore_errors: yes
          # when: local_disks_path_list | length > 0
          when: local_disks_path_list is defined and local_disks_path_list | length > 0


        - name: "Extract partition numbers for deletion"
          set_fact:
            partitions_to_delete: "{{ partition_info.results | selectattr('item', 'eq', item) | first | default({}) | stdout | regex_findall('^\\d+') | map('int') | list }}"
          loop: "{{ local_disks_path_list }}"
          # when: partition_info.results is defined
          when: partition_info.results is defined and local_disks_path_list | length > 0


        # - name: "Extract partition numbers for each disk"
