---




# - name: "Shut down ESXi after disk wipe"
#   ssh_check_esxi_with_pass:
#     hostname: "{{ esxi_fqdn }}"
#     username: "{{ remote_username }}"
#     password: "{{ remote_password }}"
#     command: "shutdown -h now"
#   delegate_to: localhost



    - name: Initiating Server Shutdown Command
      throttle: 1
      block:

        - name: Display the JSON file content
          shell: cat record_shutdown.json
          delegate_to: localhost
          register: TR_result_shutdown_esxi

        - name: save the Json data to a Variable as a Fact
          set_fact:
            record_id_shutdown_esxi: "{{ TR_result_shutdown_esxi.stdout[1:-1] }}"
          delegate_to: localhost         

        - meta: end_host
          when: record_id_shutdown_esxi== ""   

        - set_fact:
            shutdown_success: "shutdown_success.yml"
            shutdown_failure: "shutdown_failure.yml"

        - name: Display the JSON file content
          shell: cat private_endpoint_connection_string.yml
          delegate_to: localhost
          register: result_private_endpoint_connection_string
    
        - name: save the Json data to a Variable as a Fact
          set_fact:
            private_endpoint_connection_string: "{{ result_private_endpoint_connection_string.stdout }}"
          delegate_to: localhost

        - name: "Check entry for DECO server from Azure"
          azure_update_ref_esxi:
            connection_string: "{{ private_endpoint_connection_string }}"
            hostname: "{{inventory_hostname}}"                        
          register: idem_status
          delegate_to: localhost    

        - debug:
            var: idem_status

        - set_fact: 
            shutdown_server: '{{idem_status.module_update.server_shutdown}}'                

        - set_fact: 
            nvme_cleanup: '{{idem_status.module_update.nvme_cleanup}}'   

        - name: End play for this host
          meta: end_host
          when: nvme_cleanup != "T" or shutdown_server != "F"


        - set_fact: 
            esxi_fqdn: '{{idem_status.module_update.fqdn_info}}'   

        - name: Get timestamp from the system
          shell: "date +%Y-%m-%d/%H:%M"
          delegate_to: localhost
          register: tstamp              
                  
        - set_fact:
            time: "{{tstamp.stdout}}"

        # - name: "Identify local storage devices on ESXi"
        #   ssh_check_esxi_with_pass:
        #     hostname: "{{ esxi_fqdn }}"
        #     username: "{{ remote_username }}"
        #     password: "{{ remote_password }}"
        #     command: "esxcli storage core device list | awk -F ': ' '/Devfs Path:/ {dev = $2} /Is Local: true/ {print dev}'"
        #   register: local_disks
        #   delegate_to: localhost

        - name: "Identify local non-cdrom, non-boot storage devices on ESXi"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli storage core device list | awk '!/^[[:space:]]/ {if (dev && local && boot && dev !~ /cdrom/) print dev; dev=$1; local=0; boot=0} /Is Local: true/ {local=1} /Is Boot Device: false/ {boot=1} END {if (dev && local && boot && dev !~ /cdrom/) print dev}'"
          register: local_disks
          delegate_to: localhost



        - name: "Set local disks list"
          set_fact:
            local_disks_list: "{{ local_disks.output.split('\n') | reject('equalto', '') | list }}"  # Reject empty strings
          when: local_disks is defined and local_disks.output is defined and local_disks.output | length > 0

        # - name: Log Success for Local Storage Devices Fetch
        #   shell: echo "{{ inventory_hostname }}, {{ time }}, [INFO] - Local storage devices fetched successfully {{ local_disks.output }}" >> {{ shutdown_success }} 
        #   delegate_to: localhost
        #   # when: "'Successfully' in local_disks.msg"
        #   when: local_disks.status == 'success'
        #   # when: local_disks.rc == 0

        # - name: Log Failure for Local Storage Devices Fetch
        #   shell: echo "{{ inventory_hostname }}, {{ time }}, [ERROR] - Failed to fetch local storage devices for {{ inventory_hostname }}" >> {{ shutdown_failure }} 
        #   delegate_to: localhost
        #   when: local_disks.status == 'failure'

        # - meta: end_host
        #   when: local_disks.status == 'failure'


        - name: "Get VMFS extents for each local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            # command: "esxcli storage vmfs extent list | grep '{{ item | basename }}' || true"
            # command: "esxcli storage vmfs extent list | grep '{{ item | basename }}' | awk '{print $1}' || true"
            command: "esxcli storage vmfs extent list | grep '{{ item }}' | awk '{print $1}' || true"
          loop: "{{ local_disks_list | default([]) }}"
          register: vmfs_extents_info
          delegate_to: localhost
          when: local_disks_list is defined and local_disks_list | length > 0  # Only run if local_disks_list is defined and has items

        - name: Debug custom module output
          debug:
            var: vmfs_extents_info
          when: vmfs_extents_info is defined


        - name: "Extract volume names from VMFS extents info"
          set_fact:
            # vmfs_volumes_list: "{{ vmfs_extents_info.results | map(attribute='output') | list }}"
            vmfs_volumes_list: "{{ vmfs_extents_info.results | map(attribute='output') | map('trim') | list }}"
          when: vmfs_extents_info is defined and vmfs_extents_info.results | length > 0


        - name: "Unmount VMFS datastore for each local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli storage filesystem unmount -l '{{ vmfs_volumes_list[loop.index0] }}'"
          loop: "{{ local_disks_list }}"
          loop_control:
            index_var: loop_index0
          # when: vmfs_volumes_list | length > loop_index0 and vmfs_volumes_list[loop_index0] | trim != ''
          when: local_disks_list is defined and local_disks_list | length > 0 and vmfs_volumes_list | length > loop_index0 and vmfs_volumes_list[loop_index0] | trim != ''
          delegate_to: localhost


        - name: "Delete VMFS datastore for each local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli storage vmfs volume delete -l '{{ item.stdout }}'"
          loop: "{{ vmfs_extents_info.results }}"
          when: item.stdout != ''
          delegate_to: localhost



# ===========================================================================================================================

