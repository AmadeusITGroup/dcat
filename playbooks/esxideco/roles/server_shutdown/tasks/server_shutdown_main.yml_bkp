        #   loop: "{{ local_disks_list }}"
        #   when: partition_info.results is defined

        - name: "Delete partitions on the local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "partedUtil delete {{ item }} {{ item }}"
          loop: "{{ partitions_to_delete }}"
          delegate_to: localhost
          register: delete_partition_results
          ignore_errors: yes
          # when: partitions_to_delete | length > 0
          when: partitions_to_delete is defined and partitions_to_delete | length > 0


