        - name: "Disable local disk"
          ssh_check_esxi_with_pass:
            hostname: "{{ esxi_fqdn }}"
            username: "{{ remote_username }}"
            password: "{{ remote_password }}"
            command: "esxcli storage core device set --device {{ item }} --state off"
          loop: "{{ local_disks_uuid_list }}"
          # when: local_disks_uuid_list | length > 0
          when: local_disks_uuid_list is defined and local_disks_uuid_list | length > 0
          delegate_to: localhost
          register: disable_disk_results
          ignore_errors: yes

        # - name: Log Success for Disabling Local Disk
